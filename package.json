{
  "name": "sender-chile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SENDER Chile — Tecnología que transmite. Ingeniería RF, radiodifusión y telecomunicaciones.",
  "scripts": {
    "dev": "vite",
    "build": "npm run guard && tsc -b && vite build && npm run sitemap && npm run fixbase",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "assets": "python3 scripts/optimize-assets.py",
    "sitemap": "python3 scripts/build-sitemap.py",
    "fixbase": "node scripts/fix-base.mjs",
    "qa": "node qa/qa.mjs",
    "qa:control": "node qa/probe-test.mjs",
    "guard": "node qa/no-opacity-text.mjs",
    "serve": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "motion": "^13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "playwright": "^1.63.0"
  }
}
